{
  "name": "@ai-message-polisher",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "npm run build --workspace @ai-message-polisher/contracts",
    "start:web": "npm run start --workspace @ai-message-polisher/web",
    "build:web": "npm run build --workspace @ai-message-polisher/web",
    "build:netlify": "npm run build:contracts && npm run build:web && node scripts/write-netlify-redirects.mjs",
    "test:web": "npm run test --workspace @ai-message-polisher/web",
    "start:api": "npm run dev --workspace @ai-message-polisher/api",
    "build": "npm run build:web"
  }
}
