    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
